# AlienVault OTX API Configuration
# Copy this file to .env and fill in your actual API key

# AlienVault OTX API Key (from https://otx.alienvault.com/api)
OTX_API_KEY=your_actual_api_key_here

# Optional: Enable/disable OTX threat checking
OTX_ENABLED=true

# Optional: Timeout for API requests (seconds)
OTX_TIMEOUT=5
